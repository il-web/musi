#!/usr/bin/env bash
# musi BT/DAC audio auto-router.
# Routes MPD output to whichever Bluetooth device is connected, or the DAC when
# none is. Watches BlueALSA for connect/disconnect events.
set -u
ASOUNDRC="$HOME/.asoundrc"
FLAG=/tmp/musi-bt-connecting
USER_FLAG=/tmp/musi-bt-user-disconnect   # written by the app before an intentional disconnect
RECONNECT_TRIES=3
MON="$(command -v bluealsactl || command -v bluealsa-cli)"
rm -f "$FLAG" "$USER_FLAG" 2>/dev/null

dac_dev() {
  # Reference the DAC by its stable card NAME, not index — the ALSA card index
  # is not stable across boots (HDMI sometimes claims card 0, pushing the DAC to
  # card 1), which made "hw:0,0" open HDMI and fail with ENOTSUPP (error 524).
  id="$(aplay -l 2>/dev/null | sed -n 's/^card [0-9]*: \([^ ]*\).*[Hh]ifi[Bb]erry.*/\1/p' | head -1)"
  [ -z "$id" ] && id="sndrpihifiberry"
  echo "hw:$id,0"
}

write_dac() {
  { echo "pcm.musiout {"
    echo "    type plug"
    echo "    slave.pcm \"$(dac_dev)\""
    echo "}"
  } > "$ASOUNDRC"
}

write_bt() {
  { echo "pcm.musiout {"
    echo "    type plug"
    echo "    slave.pcm \"bluealsa:DEV=$1,PROFILE=a2dp\""
    echo "}"
  } > "$ASOUNDRC"
}

restart_mpd() {
  systemctl --user restart mpd
  for i in $(seq 1 30); do mpc status >/dev/null 2>&1 && break; sleep 0.3; done
}

bt_name() {
  name="$(bluetoothctl info "$1" 2>/dev/null | sed -n 's/.*Name: //p' | head -1)"
  [ -z "$name" ] && name="$1"
  echo "$name"
}

remaining_bt() {
  "$MON" list-pcms 2>/dev/null | grep -oE 'dev_[0-9A-Fa-f_]+' | head -1 | sed 's/^dev_//; s/_/:/g'
}

# The current slave.pcm target written in ~/.asoundrc (or empty).
current_target() {
  sed -n 's/.*slave\.pcm "\(.*\)".*/\1/p' "$ASOUNDRC" 2>/dev/null | head -1
}

to_bt() {
  want="bluealsa:DEV=$1,PROFILE=a2dp"
  # One connect emits several PCM events (a2dp source + sink); only act on the
  # first. If already routed to this device, just ensure playback — no restart.
  if [ "$(current_target)" = "$want" ]; then
    mpc -q play 2>/dev/null
    return
  fi
  bt_name "$1" > "$FLAG"
  write_bt "$1"
  restart_mpd
  rm -f "$FLAG"
  mpc -q play 2>/dev/null
}

to_dac() {
  [ "$(current_target)" = "$(dac_dev)" ] && return
  write_dac
  restart_mpd
}

bt_connected() {
  bluetoothctl info "$1" 2>/dev/null | grep -q "Connected: yes"
}

# True while a fresh user-disconnect flag exists (the app wrote it just before
# an intentional disconnect) — the watchdog must not fight the user. A stale
# flag (>60 s) is ignored and cleaned so it can't block real drop recovery.
user_disconnected() {
  [ -f "$USER_FLAG" ] || return 1
  now=$(date +%s); mt=$(stat -c %Y "$USER_FLAG" 2>/dev/null || echo 0)
  [ $((now - mt)) -le 60 ] && return 0
  rm -f "$USER_FLAG"
  return 1
}

# Unexpected drop (range, interference, speaker hiccup): try to get the same
# device back before giving up. A successful connect emits PCMAdded, which the
# monitor loop routes as usual — playback resumes where it was.
try_reconnect() {
  for _ in $(seq 1 "$RECONNECT_TRIES"); do
    sleep 3
    bluetoothctl connect "$1" >/dev/null 2>&1
    sleep 2
    bt_connected "$1" && return 0
  done
  return 1
}

[ -z "$MON" ] && { echo "no bluealsa cli found"; exit 1; }

# startup: make sure ~/.asoundrc names the right output, but only restart MPD if
# it actually needs to change. On a normal boot the file is already correct, so
# we must NOT restart MPD here — doing so races the app's startup MPD connection.
start_mac="$(remaining_bt)"
if [ -n "$start_mac" ]; then
  start_target="bluealsa:DEV=$start_mac,PROFILE=a2dp"
else
  start_target="$(dac_dev)"
fi
if [ "$(current_target)" != "$start_target" ]; then
  if [ -n "$start_mac" ]; then write_bt "$start_mac"; else write_dac; fi
  restart_mpd
fi

"$MON" monitor 2>/dev/null | while read -r line; do
  case "$line" in
    *PCMAdded*)
      mac="$(printf '%s' "$line" | grep -oE 'dev_[0-9A-Fa-f_]+' | head -1 | sed 's/^dev_//; s/_/:/g')"
      [ -n "$mac" ] && to_bt "$mac"
      ;;
    *PCMRemoved*)
      mac="$(printf '%s' "$line" | grep -oE 'dev_[0-9A-Fa-f_]+' | head -1 | sed 's/^dev_//; s/_/:/g')"
      # one disconnect emits several PCM events; if the device is already back
      # (or the watchdog just recovered it) there is nothing to do
      if [ -n "$mac" ] && bt_connected "$mac"; then continue; fi
      other="$(remaining_bt)"
      if [ -n "$other" ]; then
        to_bt "$other"
      elif [ -n "$mac" ] && ! user_disconnected && try_reconnect "$mac"; then
        : # reconnected — the PCMAdded event it fires re-routes and resumes
      else
        to_dac
      fi
      ;;
  esac
done
