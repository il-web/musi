#!/usr/bin/env bash
# shairport-sync session hooks (see pi/shairport-sync.conf).
#
#   begin — a phone's session starts: stop MPD so the shared audio output
#           is free, and raise the flag the musi UI watches.
#   end   — the session is over (stopped, or paused past the active-state
#           timeout): drop the flag; musi goes back to MPD.
# A short pause on the phone does NOT end the session — musi shows it paused.
#
# MPD is *stopped*, not paused: a paused MPD can keep the ALSA device open,
# and then shairport-sync couldn't. The queue and current song are kept.
set -u
FLAG=/tmp/musi-airplay

case "${1:-}" in
  begin)
    date +%s > "$FLAG"
    mpc -q stop 2>/dev/null || true
    ;;
  end)
    rm -f "$FLAG"
    ;;
esac
exit 0
