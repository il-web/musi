[Unit]
Description=musi player UI
# Start after the user MPD is up; the app's loading screen waits for MPD anyway.
After=mpd.service
Wants=mpd.service

[Service]
# run.sh self-detects the SPI panel's DRM card and the music dir.
ExecStart=/bin/bash %h/musi/run.sh
Restart=always
RestartSec=3
# The boot splash is quit by the app itself, right before it opens the
# display (player/splash.py) — quitting it here left the console showing
# while Python started up.

[Install]
WantedBy=default.target
